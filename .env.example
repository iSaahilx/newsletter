OPENAI_API_KEY=sk-your-key

# Models are intentionally split so cheap models handle filtering and stronger
# models handle final synthesis.
OPENAI_SMALL_MODEL=gpt-4.1-nano
OPENAI_LARGE_MODEL=gpt-4.1-mini

DATABASE_PATH=data/intelligence.sqlite3
OUTPUT_DIR=output
MAX_ITEMS_PER_RUN=180
SCORING_ITEM_LIMIT=72
FINAL_BRIEF_ITEM_LIMIT=28
RSS_ITEMS_PER_SOURCE=20
MIN_IMPORTANCE_SCORE=70
MARKET_MOVE_THRESHOLD_PERCENT=3

# Optional: set to your email sender later if you add delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# BRIEF_TO_EMAIL=
